{
  "expo": {
    "name": "NextRep",
    "slug": "nextrep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nextrep",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nextrep.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "NextRep needs access to your camera to take photos for listings.",
        "NSPhotoLibraryUsageDescription": "NextRep needs access to your photo library to upload images for listings.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6F5"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nextrep.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "NextRep needs access to your photos to upload images for listings.",
          "cameraPermission": "NextRep needs access to your camera to take photos for listings."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#232222"
        }
      ]
    ],
    "extra": {
      "siteUrl": "https://nextrep-fd6a57ecb582.herokuapp.com/"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
